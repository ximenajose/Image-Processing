# TOOLS
import numpy as np
import matplotlib.pyplot as plt

# FUNCTION: CREATE FUNCTION COMPARE CSV AND GIVE IT TWO FILES TO COMPARE
def compare_csv(input1_path, input2_path):

# LOADING: LOAD CSV FILESINTO NUMPY ARRAYS AND SKIP HEADER
    input1 = np.loadtxt(input1_path, delimiter=",", skiprows=1)
    input2 = np.loadtxt(input2_path, delimiter=",", skiprows=1)

# COORDINATE CHECK: TO TREAT CORRESPONDING ROWS AS CORRESPONDING PIXELS (CLASSIC UPSTREAM REGISTRATION ISSUE! YAY!)
    if not np.array_equal(input1[:, :2], input2[:, :2]):
        raise ValueError("CSV files do not contain matching XY positions.")

# DIMENSIONS: DETERMINES IMAGE DIMENSIONS FOR REBUILD
    w = int(input1[:, 0].max()) +1
    h = int(input1[:, 1].max()) +1

# CONTAINERS: CREATE EMPTY NUMPY ARRAYS
    input1_rgb = np.zeros((h, w, 3), dtype=np.uint8)
    input2_rgb = np.zeros((h, w, 3), dtype=np.uint8)

# LOCATION: EXTRACT PIXEL COORDINATES 
    y = input1[:, 1].astype(int)
    x = input1[:, 0].astype(int)

# REBUILD: TAKE RGB COLUMNS FROM EACH CSV, PLACE IN CORRESPONDING LOCATIONS
    input1_rgb[y, x] = input1[:, 2:5].astype(np.uint8)
    input2_rgb[y, x] = input2[:, 2:5].astype(np.uint8)

# DELTA: CALCULATES PIXEL DIFFERENCES FROM INPUT 2 TO INPUT 1 IN ABSOLUTE VALUE, THEN CONVERT RESULT TO 8-BIT RGB
    difference = np.abs(
        input2_rgb.astype(int) - input1_rgb.astype(int)
    ).astype(np.uint8)

# COMPARISON: DISPLAY ORIGINAL, CHANGED, AND DIFFERENCE IMAGES
    plt.figure(figsize=(18, 6))

    plt.subplot(1, 3, 1)
    plt.imshow(input1_rgb)
    plt.title("Input 1 Image")
    plt.axis("on")

    plt.subplot(1, 3, 2)
    plt.imshow(input2_rgb)
    plt.title("Input 2 Image")
    plt.axis("on")

    plt.subplot(1, 3, 3)
    plt.imshow(difference)
    plt.title("Difference Image")
    plt.axis("on")

    plt.show()


# OUTPUT: COMPARE TWO OUTPUT CSV FILES
compare_csv(
    "/Users/YourUser/Decomposed_Input_Image_1.csv",
    "/Users/YourUser/Decomposed_Input_Image_2.csv"
)




